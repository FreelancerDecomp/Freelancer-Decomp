// FLDedicated.exe (PORT(dedicated)). The VERSIONINFO is FLServer.exe's (src\FLServer\FLServer.rc):
// the server reads its own file version through DACOM_GetDllVersion and sends it to clients in
// the host-discovery response, so the two executables must report the same version.
#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

128 ICON "..\\FLServer\\res\\ICON128_1.ico"


1 VERSIONINFO
FILEVERSION 1,0,1254,11
PRODUCTVERSION 1,0,1254,11
FILEOS 0x40004
FILETYPE 0x1
BEGIN
BLOCK "StringFileInfo"
BEGIN
	BLOCK "040904b0"
	BEGIN
		VALUE "FileDescription", "Freelancer Decomp dedicated server"
		VALUE "FileVersion", "1, 0, 0, 0"
		VALUE "ProductName", "Freelancer Decomp"
		VALUE "ProductVersion", "1, 0, 0, 0"
	END
END

BLOCK "VarFileInfo"
BEGIN
	VALUE "Translation", 0x0409, 0x04B0
END
END
