    <ClCompile Include="rpc_payload_ch2.cpp" />
    <ClCompile Include="rpc_payload_ch3.cpp" />
    <ClCompile Include="rpc_containers.cpp" />
    <ClCompile Include="rpc_wire_ch1.cpp" />
    <ClCompile Include="rpc_wire_ch2.cpp" />
    <ClCompile Include="rpc_wire_generic.cpp" />
    <ClCompile Include="rpc_wire_fields.cpp" />
    <ClCompile Include="rpc_wire_varlen.cpp" />
    <ClCompile Include="rpc_wire_closeout.cpp" />
    <ClCompile Include="rpc_wire_ch3.cpp" />
    <ClCompile Include="rpc_packet_dump.cpp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Retail rpclocal.dll imports DACOM.DLL::FDUMP (ordinal 13, IAT slot
         .rdata:06db311c) and calls it from five sites: 06d86b0f, 06d86b40, 06d86b70,
         06d86be0 (the debug-only channel-3 cases of FUN_06d86a70) and 06d8f265
         (IServerImpl::Startup, LoadLibrary failure). Referenced as a project the same
         way Server, Common and the rest link dacom.lib. -->
    <ProjectReference Include="..\dacom\dacom.vcxproj">
      <Project>{8F3A1B20-9C4D-4E5F-A617-B8C9D0E1F203}</Project>
    </ProjectReference>
    <!-- Common.lib is linked above (retail imports COMMON.DLL FmtStr exports); the
         reference makes MSBuild build Common before rpclocal links against it, the
         same way freelancer.vcxproj orders itself after Common. -->
    <ProjectReference Include="..\Common\Common.vcxproj">
      <Project>{C0A4E8B1-2D5F-4A17-9C36-E8B0D1F2A405}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>