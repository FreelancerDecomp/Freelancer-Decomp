<Project>
  <PropertyGroup>
    <!-- The feature switches' defaults, for every project. Freelancer.Diagnostics.props (the VS
         property page) holds only values saved there, which override these. -->
    <FreelancerEnableTickProfile Condition="'$(FreelancerEnableTickProfile)'==''">0</FreelancerEnableTickProfile>
    <!-- PORT(diag): "Beta 2" on-screen label, FREELANCER_BETA_LABEL; off by default. -->
    <FreelancerBetaLabel Condition="'$(FreelancerBetaLabel)'==''">0</FreelancerBetaLabel>
    <!-- PORT(widescreen): widescreen (Hor+) support, FREELANCER_WIDESCREEN_SUPPORT; 0 builds retail's 4:3-only client. -->
    <FreelancerWidescreenSupport Condition="'$(FreelancerWidescreenSupport)'==''">1</FreelancerWidescreenSupport>
    <!-- PORT(rp9): Direct3D 9 rendering (RP9.dll + the client's Ex hooks: volumetric nebula),
         FREELANCER_RP9; 0 builds neither RP9.dll nor the client hooks (docs/re/rp9.md). -->
    <FreelancerRp9 Condition="'$(FreelancerRp9)'==''">0</FreelancerRp9>
    <!-- PORT(rpgpu): SDL3 + SDL_GPU render pipeline (RPGPU.dll, docs/re/rpgpu.md), SDL3 from vcpkg
         (src/Vcpkg.props). On by default on x64, whose client has no other renderer (RP8 needs
         D3DX8, which is 32-bit only); off on Win32, where RP8 is the renderer and RPGPU an option.
         Not in Freelancer.Diagnostics.props: RPGPU.vcxproj reads it before that sheet. -->
    <FreelancerRpGpu Condition="'$(FreelancerRpGpu)'=='' and '$(Platform)'=='x64'">1</FreelancerRpGpu>
    <FreelancerRpGpu Condition="'$(FreelancerRpGpu)'==''">0</FreelancerRpGpu>
    <!-- true: a port-only module that is on but cannot find vcpkg fails the build instead of
         being skipped with a warning (src/Vcpkg.targets). CI passes it. -->
    <FreelancerRequireVcpkg Condition="'$(FreelancerRequireVcpkg)'==''">false</FreelancerRequireVcpkg>
    <!-- PORT(walk): walk mode in base rooms (docs/walk_mode.md), FREELANCER_WALK_MODE; on by default, as
         the Diagnostics property page shows it (only the client reads it). -->
    <FreelancerWalkMode Condition="'$(FreelancerWalkMode)'==''">1</FreelancerWalkMode>
    <PlatformToolset>v143</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <CharacterSet>MultiByte</CharacterSet>
    <!-- Output dir name per configuration: Release -> bin, Debug -> bin_debug, DebugASan -> binasan.
         All are siblings at the repo root, so every ..\DATA / ..\EXE path resolves alike. -->
    <FlBinDirName>bin</FlBinDirName>
    <FlBinDirName Condition="'$(Configuration)'=='Debug'">bin_debug</FlBinDirName>
    <FlBinDirName Condition="'$(Configuration)'=='DebugASan'">binasan</FlBinDirName>
    <!-- PORT(x64): x64 build of the server modules (docs/x64.md), in parallel with Win32, which
         stays the retail reference: Release -> bin_x64, Debug -> bin_x64_debug. -->
    <FlBinDirName Condition="'$(Platform)'=='x64'">bin_x64</FlBinDirName>
    <FlBinDirName Condition="'$(Platform)'=='x64' and '$(Configuration)'=='Debug'">bin_x64_debug</FlBinDirName>
    <OutDir>$(MSBuildThisFileDirectory)..\$(FlBinDirName)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\$(Configuration)\</IntDir>
    <IntDir Condition="'$(Platform)'=='x64'">$(MSBuildThisFileDirectory)obj\$(MSBuildProjectName)\$(Configuration)_x64\</IntDir>
    <PreferredToolArchitecture>x86</PreferredToolArchitecture>
    <PreferredToolArchitecture Condition="'$(Platform)'=='x64'">x64</PreferredToolArchitecture>
    <!-- DirectX 8.1 SDK (repo-root dx8/, gitignored). Headers via IncludePath append
         (old basetsd.h must not precede the Windows 10 SDK). Override: /p:Dx8SdkDir=... -->
    <Dx8SdkDir Condition="'$(Dx8SdkDir)'==''">$(MSBuildThisFileDirectory)..\dx8</Dx8SdkDir>
    <!-- DirectX SDK June 2010 (RP9 only: D3DX9 headers/import lib, DxErr, d3dx9_43 redist cab).
         Defaults to the installer's DXSDK_DIR (with or without a trailing slash). Its Include dir holds an
         older d3d9.h, so RP9.vcxproj appends it after the Windows SDK. Override: /p:Dx9SdkDir=... -->
    <Dx9SdkDir Condition="'$(Dx9SdkDir)'==''">$(DXSDK_DIR)</Dx9SdkDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <!-- No /sdl, for every project. /sdl zero-fills the members of a class allocated with new
           before its constructor runs and poisons pointers after delete, which hides the
           uninitialised-member behaviour the VC6-built retail modules have, and gives every
           dllexport class an exported __autoclassinit2 that retail does not export. -->
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>WIN32;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- src/include, and src/IVP as the root of the Ipion physics headers ("ivp_physics/...")
           that Common.dll's public ABI is built on. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)include;$(MSBuildThisFileDirectory)IVP;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- FL_LAYOUT_ASSERT: the retail struct size and offset checks (Win32 only). -->
      <ForcedIncludeFiles>fl_layout.h;%(ForcedIncludeFiles)</ForcedIncludeFiles>
      <!-- C4251 / C4275: exported classes hold STL members and derive from non-exported bases
           (common_exports.h); their consumers do not need the dll-interface. -->
      <DisableSpecificWarnings>4251;4275;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <RuntimeLibrary Condition="'$(Configuration)'=='Debug' or '$(Configuration)'=='DebugASan'">MultiThreadedDebugDLL</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(Configuration)'=='Release'">MultiThreadedDLL</RuntimeLibrary>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <!-- /std:c++20 implies /permissive-; keep /permissive (the C++17 default) so the
           decompiled sources compile unchanged. Opting into conformance is separate work. -->
      <ConformanceMode>false</ConformanceMode>
      <!-- x87 floating point (/arch:IA32), as the VC6-built retail modules. Retail leaves
           FPU_PRESERVE off (EXE\dacom.ini; rp8.dll reads the key at .text:06d06bb4), so
           Direct3D 8 CreateDevice drops the main thread's x87 precision control to 24-bit and
           never restores it. x87 code inherits that; SSE2 code ignores the control word and
           would keep 53-bit doubles where retail has 24-bit. x64 has no x87 code generation:
           it always uses SSE2 (docs/x64.md). -->
      <EnableEnhancedInstructionSet Condition="'$(Platform)'=='Win32'">NoExtensions</EnableEnhancedInstructionSet>
      <FloatingPointModel>Precise</FloatingPointModel>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(OutDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
