  <!-- dalib_net.h (DirectPlay8 network classes freelancer.exe exports like retail) needs
       dplay8.h from the DX8 SDK; appended last so the Windows SDK basetsd.h wins. -->
  <PropertyGroup>
    <IncludePath>$(IncludePath);$(Dx8SdkDir)\include</IncludePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)..\include;$(ProjectDir)..\Content;$(ProjectDir)..\imeui;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- FREELANCER_EXPORTS selects the declarations freelancer.exe exports itself
           (retail FreeLancer.exe carries a 69-name export table, no .def): see the
           export macros in src/include/rpc_iclient.h and src/include/common_exports.h. -->
      <PreprocessorDefinitions>FREELANCER_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- /sdl makes the compiler give every dllexport class with data members an
           exported __autoclassinit2 member (bin\Server.dll showed 12 before Server.vcxproj
           turned it off). Retail FreeLancer.exe exports none, and the exe must export
           exactly the names retail exports. -->
      <SDLCheck>false</SDLCheck>
      <MultiProcessorCompilation Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">true</MultiProcessorCompilation>
      <MultiProcessorCompilation Condition="'$(Configuration)|$(Platform)'=='DebugASan|Win32'">true</MultiProcessorCompilation>
      <MultiProcessorCompilation Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">true</MultiProcessorCompilation>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalLibraryDirectories>$(ProjectDir)..\bin;$(ProjectDir)..\..\bin;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>dacom.lib;DALib.lib;Common.lib;imeui.lib;ole32.lib;gdi32.lib;user32.lib;advapi32.lib;shell32.lib;winmm.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(ProjectDir)resources;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ResourceCompile>
  </ItemDefinitionGroup>
