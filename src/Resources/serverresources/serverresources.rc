    MENUITEM "Server &News...",  32778
  }
  POPUP "&View"
  {
    MENUITEM "&Status Bar",  59393
    MENUITEM SEPARATOR
    MENUITEM "Status S&ummary",  32780
    MENUITEM "&Console",  32781
  }
  POPUP "&Chat"
