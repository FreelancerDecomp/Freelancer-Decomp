// FLServer.exe's own .rsrc: icon 128 and VERSIONINFO only
// (EXE\Disasm\DecompiledResources\FLServer.rc). Every dialog, menu, toolbar, accelerator
// and string the application uses lives in ServerResources.dll (src\Resources\serverresources),
// which InitInstance loads and installs as the MFC resource handle.
#include <windows.h>

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

128 ICON "res\\ICON128_1.ico"


1 VERSIONINFO
FILEVERSION 1,0,1254,11
PRODUCTVERSION 1,0,1254,11
FILEOS 0x40004
FILETYPE 0x2
BEGIN
BLOCK "StringFileInfo"
BEGIN
	BLOCK "040904b0"
	BEGIN
		VALUE "CompanyName", "Microsoft Corporation"
		VALUE "FileDescription", "Freelancer"
		VALUE "FileVersion", "1, 0, 0, 0"
		VALUE "LegalCopyright", "\251 2003 Microsoft Corporation.  All rights reserved."
		VALUE "PrivateBuild", "Release"
		VALUE "ProductName", "Freelancer"
		VALUE "ProductVersion", "1, 0, 0, 0"
	END
END

BLOCK "VarFileInfo"
BEGIN
	VALUE "Translation", 0x0409, 0x04B0
END
END
